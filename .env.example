# Application
APP_NAME=Cyber Threat Intelligence Platform
APP_ENV=development
API_PREFIX=/api/v1

# Database (required — no default; app will fail to start if missing)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/HackerTracker_db

# CORS allowed origins — JSON array
# Development:
CORS_ORIGINS=["http://localhost:5174","http://localhost:5175","http://localhost:5176"]
# Production example:
# CORS_ORIGINS=["https://hacker-tracker-75f91.web.app"]

# Logging
LOG_LEVEL=DEBUG

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Frontend
# Development:
FRONTEND_URL=http://localhost:5174
# Production example:
# FRONTEND_URL=https://hacker-tracker-75f91.web.app

# External Integrations (TODO: Update with actual credentials)
# CISA KEV
# CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# NVD API
# NVD_API_KEY=your_key_here

# Have I Been Pwned domain search (Tier 2 findings — paid, ~$3.50/mo)
# HIBP_API_KEY=your_key_here

# Shodan host lookup — open ports, service banners, CVEs (100 free credits/month)
# SHODAN_API_KEY=your_key_here

# AlienVault OTX threat intel — pulse count, malware families (free, register at otx.alienvault.com)
# OTX_API_KEY=your_key_here

# Gemini AI Summary
# GEMINI_API_KEY=your_key_here
# GEMINI_MODEL=gemini-2.5-flash
# AI_SUMMARY_ENABLED=true
# AI_SUMMARY_CACHE_TTL=3600

# Ingestion scheduling — standard 5-field cron expressions (empty = disabled)
# INGEST_SCHEDULE_NVD=0 */6 * * *        # every 6 hours
# INGEST_SCHEDULE_KEV=0 */4 * * *        # every 4 hours
# INGEST_SCHEDULE_IC3=0 2 * * 0          # weekly Sunday 2am
# INGEST_SCHEDULE_ECONOMICS=0 3 1 * *    # monthly on the 1st at 3am
# INGEST_LOCK_TIMEOUT_SECONDS=3600
# INGEST_MAX_RETRIES=2
# SCHEDULER_ENABLED=true                 # set to false on secondary instances

# Celery (when added)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Auth (generate with: openssl rand -hex 32)
# REQUIRED in production — app refuses to start with the default value
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Feature Flags
ENABLE_DEMO_MODE=true
