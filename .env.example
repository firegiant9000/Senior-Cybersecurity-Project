# Application
APP_NAME=Cyber Threat Intelligence Platform
APP_ENV=development
API_PREFIX=/api/v1

# Database (required — no default; app will fail to start if missing)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/HackerTracker_db

# CORS allowed origins (comma-separated list for production)
CORS_ORIGINS=["http://localhost:5173"]

# Logging
LOG_LEVEL=DEBUG

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Frontend
FRONTEND_URL=http://localhost:5173

# External Integrations (TODO: Update with actual credentials)
# CISA KEV
# CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# NVD API
# NVD_API_KEY=your_key_here

# Shodan
# SHODAN_API_KEY=your_key_here

# Celery (when added)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Auth (generate with: openssl rand -hex 32)
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Feature Flags
ENABLE_DEMO_MODE=true
